{
  "expo": {
    "name": "Shopymalls",
    "slug": "shopymalls",
    "description": "Discover malls, stores, deals, events, and bookings across Jakarta.",
    "version": "1.0.0",
    "icon": "./assets/images/app-icon.png",
    "orientation": "portrait",
    "scheme": "shopymalls",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/app-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./public/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
